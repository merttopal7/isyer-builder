{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Isyer",
  "version": "1.0.0",
  "identifier": "com.isyer.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "İşyer",
        "width": 1100,
        "height": 780,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "14.0",
      "developmentTeam": "0000000000"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}

